{
  "name": "mist-lang",
  "displayName": "Mist",
  "description": "Language support for .mist single-file components — syntax highlighting, diagnostics, completions, hover, go-to-definition, rename and workspace-wide checks via mistc-lsp",
  "version": "0.3.0",
  "publisher": "tadejpolajnar",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./client.js",
  "activationEvents": [
    "onLanguage:mist"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "configuration": {
      "title": "Mist",
      "properties": {
        "mist.lspPath": {
          "type": "string",
          "default": "mistc-lsp",
          "description": "Path to the mistc-lsp binary (built with `cargo build -p mistc-lsp`)."
        }
      }
    },
    "languages": [
      {
        "id": "mist",
        "aliases": [
          "Mist",
          "mist"
        ],
        "extensions": [
          ".mist"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mist",
        "scopeName": "source.mist",
        "path": "./syntaxes/mist.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.css": "css"
        }
      }
    ]
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/TadejPolajnar/mist"
  },
  "bugs": {
    "url": "https://github.com/TadejPolajnar/mist/issues"
  },
  "homepage": "https://github.com/TadejPolajnar/mist#readme",
  "keywords": [
    "wechat",
    "miniprogram",
    "mist",
    "mistc",
    "sfc",
    "tailwind"
  ]
}

---
import { onLaunch } from 'mist'

export const config = {
  window: {
    navigationBarTitleText: 'Ledger',
    navigationBarBackgroundColor: '#0b1120',
    navigationBarTextStyle: 'white',
    backgroundColor: '#0b1120',
  },
  tabBar: {
    color: '#6a7282',
    selectedColor: '#5ea0ff',
    backgroundColor: '#0e1526',
    borderStyle: 'black',
    list: [
      { pagePath: 'pages/index/index', text: '◉ Home' },
      { pagePath: 'pages/add/add', text: '＋ Add' },
      { pagePath: 'pages/stats/stats', text: '◭ Stats' },
    ],
  },
}

onLaunch(() => {})
---

<style>
page { background: #0b1120; color: #f9fafb; font-size: 30rpx; }
button { background: transparent; padding: 0; margin: 0; line-height: inherit; }
button::after { border: none; }
.card { background: #131b2e; border: 1rpx solid #1e293f; }
.hero { background: linear-gradient(135deg, #2563eb 0%, #4f46e5 60%, #6d28d9 100%); box-shadow: 0 16rpx 48rpx rgba(37, 99, 235, 0.35); }
.press { transition: opacity 0.1s; }
.press-active { opacity: 0.6; }
</style>

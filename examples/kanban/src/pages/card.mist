---
import Cell from '../components/Cell.mist'
import SectionHeader from '../components/SectionHeader.mist'
import EmptyState from '../components/EmptyState.mist'
import { board, moveCol, removeCard, assign } from '../stores/board.ts'
import { team } from '../stores/team.ts'
import { state, derived, onLoad } from 'mist'

export const config = { navigationBarTitleText: '卡片详情' }

const COL_NAMES = { backlog: '待办池', todo: '待办', doing: '进行中', review: '评审', done: '完成' }

const id = state(0)

const card = derived(() => {
  const c = board.value.cards.find(x => x.id === id.value)
  if (!c) {
    return null
  }
  return {
    id: c.id,
    title: c.title,
    tag: c.tag,
    colName: COL_NAMES[c.col],
    assignee: c.assignee,
    canLeft: c.col !== 'backlog' && c.col !== 'todo',
    canRight: c.col !== 'done',
  }
})

const missing = derived(() => id.value !== 0 && !card.value)

const people = derived(() =>
  team.value.members.map(m => ({
    id: m.id,
    label: m.avatar + ' ' + m.name,
    picked: card.value !== null && card.value.assignee === m.id,
  }))
)

onLoad((q) => {
  id.value = Number(q.id) || -1
})

function back() {
  moveCol(id.value, -1)
}

function forward() {
  moveCol(id.value, 1)
}

function pick(member) {
  assign(id.value, member)
}

function unassign() {
  assign(id.value, '')
}

function remove() {
  removeCard(id.value)
  wx.navigateBack()
}
---
<div class="min-h-screen bg-page pb-28">
  {missing.value && <EmptyState emoji="🔍" line="卡片不存在" hint="它可能已被删除" />}

  {card.value && (
    <div>
      <div class="mx-4 mt-4 rounded-lg bg-white px-4 py-4">
        <span class="block text-stat text-ink font-semibold">{card.value.title}</span>
      </div>

      <SectionHeader title="卡片信息" />
      <div class="mx-4 rounded-lg overflow-hidden">
        <Cell label="所在列" value={card.value.colName} hint="" />
        <Cell label="分类" value={card.value.tag} hint="" />
      </div>

      <SectionHeader title="负责人" />
      <div class="mx-4 rounded-lg overflow-hidden bg-white">
        {people.value.map(m => (
          <div key={m.id} onTap={() => pick(m.id)} hover-class="pressed" class="flex items-center justify-between px-4 py-3 border-b border-hairline">
            <span class="text-cell text-ink">{m.label}</span>
            {m.picked && <span class="text-cell text-primary">✓</span>}
          </div>
        ))}
        <div onTap={unassign} hover-class="pressed" class="flex items-center px-4 py-3">
          <span class="text-cell text-mute">取消分配</span>
        </div>
      </div>

      <div onTap={remove} hover-class="pressed" class="mx-4 mt-4 rounded-full border border-danger py-2.5 flex items-center justify-center">
        <span class="text-cell text-danger">删除卡片</span>
      </div>

      <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-hairline px-4 py-3 pb-safe flex gap-3">
        <div onTap={back} hover-class="pressed" class:list={['flex-1 rounded-full py-2.5 flex items-center justify-center border', { 'border-primary': card.value.canLeft }, { 'border-line': !card.value.canLeft }]}>
          <span class:list={['text-cell font-semibold', { 'text-primary': card.value.canLeft }, { 'text-disabled': !card.value.canLeft }]}>移回上一列</span>
        </div>
        <div onTap={forward} hover-class="pressed" class:list={['flex-1 rounded-full py-2.5 flex items-center justify-center', { 'bg-primary': card.value.canRight }, { 'bg-primary-soft': !card.value.canRight }]}>
          <span class="text-cell text-white font-semibold">推进下一列</span>
        </div>
      </div>
    </div>
  )}
</div>

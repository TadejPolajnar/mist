---
import { props } from 'mist'

const { name, pctStr, barStyle } = props({ name: '', pctStr: '', barStyle: '' })
---
<div class="px-4 py-2 bg-white border-b border-hairline">
  <div class="flex items-center justify-between">
    <span class="text-body text-ink">{name}</span>
    <span class="text-caption text-mute">{pctStr}</span>
  </div>
  <div class="mt-1.5 h-1.5 rounded-full bg-tile overflow-hidden">
    <div class="h-1.5 rounded-full bg-primary" style={barStyle}></div>
  </div>
</div>

---
import { onLaunch, onError, onUnhandledRejection } from 'mist'

export const config = {
  window: {
    navigationBarTitleText: '雾讯 MistFeed',
    navigationBarBackgroundColor: '#ffffff',
    navigationBarTextStyle: 'black',
    backgroundColor: '#f7f7f7',
  },
  tabBar: {
    color: '#888888',
    selectedColor: '#07c160',
    backgroundColor: '#ffffff',
    borderStyle: 'black',
    list: [
      { pagePath: 'pages/feed/feed', text: '信息流' },
      { pagePath: 'pages/lab/lab', text: '压测台' },
    ],
  },
}

onLaunch(() => {
  console.log('mist-feed launched')
})

onError((error) => {
  console.error('mist-feed error:', error)
})

onUnhandledRejection((e) => {
  console.error('mist-feed unhandled rejection:', e.reason)
})
---

<style>
page { background: #f7f7f7; }
.pressed { opacity: 0.6; }
</style>

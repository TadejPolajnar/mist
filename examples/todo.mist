---
import { state, derived, onShow } from 'mist'

export const config = { navigationBarTitleText: 'Todos' }

const filter = state('all')
const todos = state([
  { id: 1, title: 'Ship spec', done: false },
  { id: 2, title: 'Build compiler', done: false },
])

const visible = derived(() =>
  filter.value === 'all' ? todos.value : todos.value.filter(t => !t.done)
)

function toggle(id) {
  const i = todos.value.findIndex(t => t.id === id)
  todos.value[i].done = !todos.value[i].done
}

function switchFilter() {
  filter.value = filter.value === 'all' ? 'open' : 'all'
}

onShow(() => {
  console.log('page shown')
})
---
<div class="p-4">
  <span class="text-lg font-bold">Todos ({visible.value.length})</span>
  {visible.value.map(t => (
    <div class="row" key={t.id} onTap={() => toggle(t.id)}>
      <span class={t.done ? 'line-through' : ''}>{t.title}</span>
    </div>
  ))}
  {visible.value.length === 0 && <span class="empty">Nothing here</span>}
  <button onTap={switchFilter}>Filter: {filter.value}</button>
</div>

<style>
.row { padding: 16rpx 0; }
.line-through { text-decoration: line-through; color: #999; }
.empty { color: #999; }
</style>

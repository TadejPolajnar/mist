---
import { props } from 'mist'

const { emoji, name, desc, price, sold } = props({ emoji: '', name: '', desc: '', price: 0, sold: '' })
---
<div class="flex items-center gap-3 bg-white px-4 py-3 border-b border-hairline">
  <div class="w-14 h-14 rounded-xl bg-page flex items-center justify-center">
    <span class="text-emoji-sm">{emoji}</span>
  </div>
  <div class="flex flex-col flex-1">
    <span class="text-cell text-ink">{name}</span>
    <span class="text-caption text-faint">{desc}</span>
    <span class="text-caption text-faint">{sold}</span>
  </div>
  <div class="flex flex-col items-end gap-1">
    <div class="flex items-baseline">
      <span class="text-caption text-danger">¥</span>
      <span class="text-cell text-danger font-semibold">{price}</span>
    </div>
    <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center">
      <span class="text-body text-white">+</span>
    </div>
  </div>
</div>
